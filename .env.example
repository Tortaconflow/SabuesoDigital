# ============================================================
# SABUESO DIGITAL 2.0 — CÍDIKS SALES ENGINE
# Archivo de ejemplo de configuración de entorno.
# Copia este archivo a .env y completa tus claves locales.
# NUNCA subas el archivo .env a repositorios de código.
# ============================================================

# Servidor Flask local (restringido a loopback por seguridad)
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=clave_secreta_local_sabueso_cidiks_2026

# Base de datos SQLite
DATABASE_PATH=data/sabueso_cidiks.db

# Motores de búsqueda y APIs externas (Opcionales - Sabueso funciona offline y con DuckDuckGo gratis)
GEMINI_API_KEY=
SERPAPI_KEY=
GOOGLE_MAPS_API_KEY=

# Auditoría visual Playwright (opcional, requiere navegador instalado)
ENABLE_PLAYWRIGHT=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000

# Límites de seguridad para peticiones HTTP
MAX_RESPONSE_SIZE_BYTES=5242880
REQUEST_TIMEOUT_SECONDS=10
